    <elementParameter field="TEXT" name="SCHEMA_DB" value='""'/>
    <elementParameter field="DBTABLE" name="TABLE" value='""'/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value='""'/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;TRUNCATE TABLE &quot; + context.schema_entrepot + &quot;.fait_consultation, &quot; + context.schema_entrepot + &quot;.fait_hospitalisation, &quot; + context.schema_entrepot + &quot;.fait_satisfaction, &quot; + context.schema_entrepot + &quot;.fait_deces, &quot; + context.schema_entrepot + &quot;.dim_patient, &quot; + context.schema_entrepot + &quot;.dim_diagnostic, &quot; + context.schema_entrepot + &quot;.dim_etablissement, &quot; + context.schema_entrepot + &quot;.dim_professionnel, &quot; + context.schema_entrepot + &quot;.dim_temps, &quot; + context.schema_entrepot + &quot;.dim_region_insee; INSERT INTO &quot; + context.schema_entrepot + &quot;.dim_patient (id_patient, sexe) VALUES (-1, 'I'); INSERT INTO &quot; + context.schema_entrepot + &quot;.dim_diagnostic (id_diagnostic, code_diagnostic, diagnostic) VALUES (-1, 'INCONNU', 'Non renseign\u00e9'); INSERT INTO &quot; + context.schema_entrepot + &quot;.dim_etablissement (id_etablissement, identifiant_organisation, raison_sociale_site) VALUES (-1, 'INCONNU', 'Inconnu'); INSERT INTO &quot; + context.schema_entrepot + &quot;.dim_professionnel (id_professionnel, identifiant, type_identifiant, nom) VALUES (-1, 'INCONNU', 'INCONNU', 'Inconnu')&quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value='"UTF-8"'/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="UTF-8"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tPostgresqlRow_1">
