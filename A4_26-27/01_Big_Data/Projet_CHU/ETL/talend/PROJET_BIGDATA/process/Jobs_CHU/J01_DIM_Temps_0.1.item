    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="d" expression="TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, java.time.LocalDate.of(1880, 1, 1).plusDays(row1.n).toString())" type="id_Date" nullable="true"/>
        <mapperTableEntries name="mois" expression="TalendDate.getPartOfDate(&quot;MONTH&quot;, Var.d) + 1" type="id_Integer" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="dim_temps">
        <mapperTableEntries name="id_temps" expression="Integer.valueOf(TalendDate.formatDate(&quot;yyyyMMdd&quot;, Var.d))" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="date" expression="Var.d" type="id_Date" nullable="true"/>
        <mapperTableEntries name="jour" expression="TalendDate.getPartOfDate(&quot;DAY_OF_MONTH&quot;, Var.d)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semaine" expression="java.time.LocalDate.parse(TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, Var.d)).get(java.time.temporal.IsoFields.WEEK_OF_WEEK_BASED_YEAR)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="mois" expression="Var.mois" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="trimestre" expression="(Var.mois - 1) / 3 + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semestre" expression="Var.mois &lt;= 6 ? 1 : 2" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="annee" expression="TalendDate.getPartOfDate(&quot;YEAR&quot;, Var.d)" type="id_Integer" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="n" type="id_Integer" nullable="true"/>
      </inputTables>
    </nodeData>
