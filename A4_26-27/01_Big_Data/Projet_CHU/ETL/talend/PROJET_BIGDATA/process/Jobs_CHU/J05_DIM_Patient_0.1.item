  <node componentName="tPostgresqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tPostgresqlInput_1" show="false"/>
    <elementParameter field="TEXT" name="LABEL" value="Patient (identifiants exclus)"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="V9_X"/>
    <elementParameter field="TEXT" name="HOST" value="context.pg_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.pg_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.pg_base"/>
    <elementParameter field="TEXT" name="USER" value="context.pg_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.pg_password"/>
    <elementParameter field="TEXT" name="TYPE" value="PostgreSQL"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value='""'/>
    <elementParameter field="DBTABLE" name="TABLE" value='""'/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value='""'/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT \&quot;Id_patient\&quot;, encode(hmac(\&quot;Id_patient\&quot;::text, '&quot; + context.cle_pseudo + &quot;', 'sha256'), 'hex') AS pseudonyme, \&quot;Sexe\&quot;, \&quot;Ville\&quot;, \&quot;Code_postal\&quot;, \&quot;Pays\&quot;, \&quot;Date\&quot;, \&quot;Groupe_sanguin\&quot;, \&quot;Poid\&quot;, \&quot;Taille\&quot; FROM &quot; + context.schema_source + &quot;.\&quot;Patient\&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_CURSOR" value="true"/>
    <elementParameter field="TEXT" name="CURSOR_SIZE" value="10000"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value='"UTF-8"'/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="UTF-8"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tPostgresqlInput_1">
