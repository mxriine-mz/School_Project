    </metadata>
    <metadata connector="FLOW" label="correspondance" name="correspondance">
      <column comment="" defaultValue="" key="false" length="-1" name="id_patient_source" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="64" name="pseudonyme" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="id_patient" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true">
        <mapperTableEntries name="id" expression='Numeric.sequence("patient", 1, 1)' type="id_Integer" nullable="true"/>
        <mapperTableEntries name="naissance" expression='row1.Date != null &amp;&amp; TalendDate.isDate(row1.Date.trim(), "M/d/yyyy") ? TalendDate.parseDate("M/d/yyyy", row1.Date.trim()) : null' type="id_Date" nullable="true"/>
        <mapperTableEntries name="sexe" expression='row1.Sexe == null ? "I" : row1.Sexe.trim().equalsIgnoreCase("female") ? "F" : row1.Sexe.trim().equalsIgnoreCase("male") ? "M" : "I"' type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="dim_patient">
        <mapperTableEntries name="id_patient" expression="Var.id" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="sexe" expression="Var.sexe" type="id_String" nullable="true"/>
        <mapperTableEntries name="ville" expression="row1.Ville == null || row1.Ville.trim().isEmpty() ? null : row1.Ville.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="code_postal" expression="row1.Code_postal == null || row1.Code_postal.trim().isEmpty() ? null : row1.Code_postal.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="pays" expression='"FR".equals(row1.Pays) ? "France" : row1.Pays' type="id_String" nullable="true"/>
        <mapperTableEntries name="age" expression='Var.naissance == null ? null : Integer.valueOf(java.time.Period.between(java.time.LocalDate.parse(TalendDate.formatDate("yyyy-MM-dd", Var.naissance)), java.time.LocalDate.now()).getYears())' type="id_Integer" nullable="true"/>
        <mapperTableEntries name="groupe_sanguin" expression="row1.Groupe_sanguin == null || row1.Groupe_sanguin.trim().isEmpty() ? null : row1.Groupe_sanguin.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="poids" expression='row1.Poid == null || !row1.Poid.trim().replace(",", ".").matches("-?\\d+(\\.\\d+)?") ? null : Double.valueOf(row1.Poid.trim().replace(",", "."))' type="id_Double" nullable="true"/>
        <mapperTableEntries name="taille" expression='row1.Taille == null || !row1.Taille.trim().replace(",", ".").matches("-?\\d+(\\.\\d+)?") ? null : Double.valueOf(row1.Taille.trim().replace(",", "."))' type="id_Double" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="correspondance">
        <mapperTableEntries name="id_patient_source" expression="row1.Id_patient" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="pseudonyme" expression="row1.pseudonyme" type="id_String" nullable="true"/>
        <mapperTableEntries name="id_patient" expression="Var.id" type="id_Integer" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="Id_patient" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="pseudonyme" type="id_String" nullable="true"/>
        <mapperTableEntries name="Sexe" type="id_String" nullable="true"/>
        <mapperTableEntries name="Ville" type="id_String" nullable="true"/>
        <mapperTableEntries name="Code_postal" type="id_String" nullable="true"/>
        <mapperTableEntries name="Pays" type="id_String" nullable="true"/>
        <mapperTableEntries name="Date" type="id_String" nullable="true"/>
        <mapperTableEntries name="Groupe_sanguin" type="id_String" nullable="true"/>
        <mapperTableEntries name="Poid" type="id_String" nullable="true"/>
        <mapperTableEntries name="Taille" type="id_String" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>
