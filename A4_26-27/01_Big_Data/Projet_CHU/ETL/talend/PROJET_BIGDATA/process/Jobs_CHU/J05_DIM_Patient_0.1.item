    <metadata connector="FLOW" label="dim_patient" name="dim_patient">
      <column comment="" defaultValue="" key="false" length="-1" name="id_patient" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="sexe" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" usefulColumn="true"/>
