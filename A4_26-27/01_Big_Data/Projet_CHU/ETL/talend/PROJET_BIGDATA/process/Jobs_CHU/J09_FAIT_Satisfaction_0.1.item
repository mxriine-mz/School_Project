    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true">
        <mapperTableEntries name="score" expression='row5.score == null || !row5.score.trim().replace(",", ".").matches("-?\\d+(\\.\\d+)?") ? null : Double.valueOf(row5.score.trim().replace(",", "."))' type="id_Double" nullable="true"/>
        <mapperTableEntries name="motif" expression='row5.finess_geo == null || row5.finess_geo.trim().isEmpty() ? "OBLIGATOIRE" : null' type="id_String" nullable="true"/>
