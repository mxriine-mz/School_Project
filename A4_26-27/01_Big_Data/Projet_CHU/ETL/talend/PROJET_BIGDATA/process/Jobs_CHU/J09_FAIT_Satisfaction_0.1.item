      <outputTables sizeState="INTERMEDIATE" name="satisfaction_48h" expressionFilter="Var.motif == null" activateExpressionFilter="true">
        <mapperTableEntries name="id_satisfaction" expression='Long.valueOf(Numeric.sequence("satisfaction", 1, 1))' type="id_Long" nullable="true"/>
        <mapperTableEntries name="id_etablissement" expression="row2.id_etablissement == null ? -1 : row2.id_etablissement" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="id_region" expression="row4.id_region == null ? -1 : row4.id_region" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="participation_obligatoire" expression='row5.participation == null ? null : row5.participation.startsWith("1")' type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="depot_valide" expression='row5.depot == null ? null : row5.depot.startsWith("1")' type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="nb_reponses" expression='Var.score == null ? null : (row5.nb_rep == null || !row5.nb_rep.trim().matches("-?\\d+") ? null : Integer.valueOf(row5.nb_rep.trim()))' type="id_Integer" nullable="true"/>
        <mapperTableEntries name="score" expression="Var.score" type="id_Double" nullable="true"/>
        <mapperTableEntries name="annee" expression="2020" type="id_Integer" nullable="true"/>
      </outputTables>
