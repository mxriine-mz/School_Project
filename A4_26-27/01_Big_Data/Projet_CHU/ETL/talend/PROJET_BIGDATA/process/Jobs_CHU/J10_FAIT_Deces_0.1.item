        <mapperTableEntries name="dd" expression='row2.date_deces == null || row2.date_deces.isEmpty() ? null : (row2.date_deces.length() == 4 ? row2.date_deces + "-01-01" : row2.date_deces.length() == 7 ? row2.date_deces + "-01" : row2.date_deces).replace("-00", "-01")' type="id_String" nullable="true"/>
        <mapperTableEntries name="dn" expression='row2.date_naissance == null || row2.date_naissance.isEmpty() ? null : (row2.date_naissance.length() == 4 ? row2.date_naissance + "-01-01" : row2.date_naissance.length() == 7 ? row2.date_naissance + "-01" : row2.date_naissance).replace("-00", "-01")' type="id_String" nullable="true"/>
        <mapperTableEntries name="dd_ok" expression='Var.dd != null &amp;&amp; Var.dd.matches("\\d{4}-\\d{2}-\\d{2}") &amp;&amp; TalendDate.isDate(Var.dd, "yyyy-MM-dd")' type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="dn_ok" expression='Var.dn != null &amp;&amp; Var.dn.matches("\\d{4}-\\d{2}-\\d{2}") &amp;&amp; TalendDate.isDate(Var.dn, "yyyy-MM-dd")' type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="partielle" expression="(row2.date_deces != null &amp;&amp; !row2.date_deces.equals(Var.dd)) || (row2.date_naissance != null &amp;&amp; !row2.date_naissance.isEmpty() &amp;&amp; !row2.date_naissance.equals(Var.dn))" type="id_Boolean" nullable="true"/>
