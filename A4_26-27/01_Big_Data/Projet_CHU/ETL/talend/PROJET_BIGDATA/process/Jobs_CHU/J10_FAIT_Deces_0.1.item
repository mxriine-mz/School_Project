        <mapperTableEntries name="motif" expression='row2.date_deces == null || row2.date_deces.isEmpty() ? "OBLIGATOIRE" : !Var.dd_ok ? "FORMAT" : Var.age != null &amp;&amp; (Var.age &lt; 0 || Var.age &gt; 120) ? "INCOHERENT" : null' type="id_String" nullable="true"/>
